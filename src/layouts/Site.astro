---
import "../styles/site.css";
import CardPane from "../components/CardPane.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Looplab — Max Ekman, software architect & fractional CTO",
  description = "Looplab is Max Ekman's software architecture studio in Gothenburg. Fractional CTO, architecture, cloud and advisory for companies building software that has to last.",
} = Astro.props;
// Where the card is served from; until a build sets it, its pane says coming soon.
const cardUrl = import.meta.env.PUBLIC_CARD_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL("/og.png", Astro.site);

const links = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/max-ekman/" },
  { label: "Looplab on LinkedIn", href: "https://www.linkedin.com/company/looplab-ab" },
  { label: "GitHub", href: "https://github.com/maxekman" },
  { label: "Looplab on GitHub", href: "https://github.com/looplab" },
];
---
<html lang="en" class="bg-ground">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fff8f3" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body class="bg-ground font-mono text-[13px] leading-[1.6] text-body antialiased sm:text-[15px]">
    <CardPane url={cardUrl} />
    <slot />
    <!-- Dark slate with sand type, as the 2025 site's footer. -->
    <footer class="bg-title text-sand">
      <div class="mx-auto grid max-w-[1600px] gap-x-10 gap-y-8 px-5 py-14 sm:px-10 lg:grid-cols-[240px_repeat(3,minmax(0,1fr))]">
        <span class="text-xs text-muted uppercase">Looplab</span>
        <div class="flex flex-col gap-1">
          <a href="mailto:hello@looplab.se" class="underline decoration-muted underline-offset-4 hover:decoration-sand">hello@looplab.se</a>
          <span>Gothenburg, Sweden</span>
        </div>
        <ul class="flex flex-col gap-1">
          {links.map((link) => <li><a href={link.href} class="underline decoration-muted underline-offset-4 hover:decoration-sand">{link.label}</a></li>)}
        </ul>
        <div class="flex flex-col gap-1 text-xs text-muted uppercase">
          <span>© {new Date().getFullYear()} Looplab AB</span>
          <span>VAT SE556963006301</span>
        </div>
      </div>
    </footer>
  </body>
</html>
